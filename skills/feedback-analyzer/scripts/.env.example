# 飞书自建应用凭证（开发者后台 → 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格标识（从表格 URL 中获取，见 README.md「1. 获取 app_token / table_id」）
FEISHU_APP_TOKEN=bascnxxxxxxxxxxxxxxxxxxxxxx
FEISHU_TABLE_ID=tblxxxxxxxxxxxxxxxx

# 可选：字段名与实际表格列名不一致时才需要覆盖（默认值见注释，已按真实表结构预设）
# FEISHU_FIELD_MODULE=模块
# FEISHU_FIELD_DESCRIPTION=问题描述
# FEISHU_FIELD_SCREENSHOT=问题截图图片
# FEISHU_FIELD_PRIORITY=优先级
# FEISHU_FIELD_STATUS=需求&反馈状态
# FEISHU_FIELD_PROGRESS_NOTE=进度留言
# FEISHU_FIELD_VERSION=反馈版本号
# FEISHU_FIELD_RELEASE_VERSION=发布版本号
# FEISHU_FIELD_TYPE=反馈类型
# 以下三个仅作元数据展示/透传，不参与分析推理
# FEISHU_FIELD_TASK_TYPE=任务类型
# FEISHU_FIELD_OWNER=责任人
# FEISHU_FIELD_SUBMITTER=提交人
# FEISHU_FIELD_CREATED_TIME=创建时间
# 产物B 回填的两个独立字段
# FEISHU_FIELD_RESULT=需求分析结果
# FEISHU_FIELD_SOLUTION_SUMMARY=产品|解决方案简述

# 可选：只有「需求&反馈状态」命中以下值才视为待分析（逗号分隔）。
# 留空 = 不按状态过滤，只要「需求分析结果」为空就视为待分析（会连带拉出已上线/不构成需求等历史存量，不推荐留空）。
# 本表实测：真正代表"刚提交、还没人处理"的状态值是「待分析」，强烈建议显式设置，
# 避免把历史存量（已上线/不构成需求等，虽然『需求分析结果』也是空的）误当新反馈重复分析。
FEISHU_PENDING_STATUS_VALUES=待分析

